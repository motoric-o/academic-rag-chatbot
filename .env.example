# Copy this file to .env and fill in your keys.
# NEVER commit .env or log/print API keys (see docs/project_spec.md §0.1).

# Hosted inference (Member C - Groq free tier)
GROQ_API_KEY=

# Translation (Member B) & LLM judge (Member D) - Google AI Studio
GEMINI_API_KEY=

# Optional: Hugging Face token if needed for gated models / faster downloads (Member A)
HF_TOKEN=

# Backend API runtime mode: replay (default) | live-hosted | live-local
REGQA_API_MODE=replay
